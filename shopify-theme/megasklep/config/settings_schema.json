      { "type": "color", "id": "color_text", "label": "Kolor tekstu", "default": "#111827" },
      { "type": "color", "id": "color_text_muted", "label": "Kolor tekstu (muted)", "default": "#6b7280" },
      { "type": "color", "id": "color_bg", "label": "Kolor tła", "default": "#f9fafb" },
