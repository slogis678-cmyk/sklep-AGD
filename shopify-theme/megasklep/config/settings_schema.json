        "label": "Bazowy rozmiar czcionki",
        "default": 15
      }
    ]
  },
  {
    "name": "Koszyk",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Typ koszyka",
        "options": [
