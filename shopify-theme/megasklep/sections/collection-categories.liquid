<section class="ms-section">
  <div class="ms-container">
    {% if section.settings.heading != blank %}
      <div class="ms-section__header">
        <div>
          <h2 class="ms-section__title">{{ section.settings.heading }}</h2>
          {% if section.settings.subheading != blank %}
            <p class="ms-section__subtitle">{{ section.settings.subheading }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="ms-categories-grid">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <a href="{{ block.settings.link }}" class="ms-category-card" {{ block.shopify_attributes }}>
            <div class="ms-category-card__img">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.title }}"
                  loading="lazy"
                  width="800"
                  height="400"
                >
              {% else %}
                <div class="ms-category-card__placeholder" style="background: linear-gradient(135deg, #1e3a8a, #3b82f6);"></div>
              {% endif %}
              <div class="ms-category-card__overlay"></div>
            </div>
            <div class="ms-category-card__content">
              <div class="ms-category-card__count">{{ block.settings.product_count }} produktów</div>
              <div class="ms-category-card__footer">
                <h3 class="ms-category-card__title">{{ block.settings.title }}</h3>
                <div class="ms-category-card__arrow">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </div>
              </div>
              {% if block.settings.subcategories != blank %}
                <div class="ms-category-card__tags">
                  {% assign tags = block.settings.subcategories | split: ',' %}
                  {% for tag in tags limit: 3 %}
                    <span class="ms-tag">{{ tag | strip }}</span>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategorie",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Kategorie" },
    { "type": "text", "id": "subheading", "label": "Podtytuł", "default": "Przeglądaj naszą ofertę" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategoria",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Zdjęcie" },
        { "type": "text", "id": "title", "label": "Nazwa kategorii", "default": "AGD" },
        { "type": "text", "id": "product_count", "label": "Liczba produktów", "default": "1 240" },
        { "type": "url", "id": "link", "label": "Link do kolekcji" },
        { "type": "text", "id": "subcategories", "label": "Podkategorie (oddzielone przecinkami)", "default": "Pralki, Lodówki, Zmywarki, Piekarniki" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategorie",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "AGD",
            "product_count": "1 240",
            "subcategories": "Pralki, Lodówki, Zmywarki, Piekarniki"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Elektronika",
            "product_count": "2 380",
            "subcategories": "Laptopy, Smartfony, Tablety, Telewizory"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Meble",
            "product_count": "890",
            "subcategories": "Sofy, Łóżka, Szafy, Biurka"
          }
        }
      ]
    }
  ]
}
{% endschema %}
