<section class="ms-section" id="ms-featured-products">
  <div class="ms-container">
    <div class="ms-section__header">
      <div>
        <h2 class="ms-section__title">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="ms-section__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
      {% if section.settings.view_all_label != blank and section.settings.view_all_link != blank %}
        <a href="{{ section.settings.view_all_link }}" class="ms-btn ms-btn--outline ms-btn--sm">
          {{ section.settings.view_all_label }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      {% endif %}
    </div>

    <div class="ms-product-grid">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.products_per_row | times: section.settings.rows %}
          {% render 'product-card', product: product %}
        {% else %}
          <p class="ms-empty">Brak produktów w tej kolekcji.</p>
        {% endfor %}
      {% else %}
        {% comment %} Fallback: show sample cards in editor {% endcomment %}
        {% for i in (1..8) %}
          <div class="ms-product-card ms-product-card--placeholder">
            <div class="ms-product-card__img-wrap">
              {{ 'product-' | append: i | placeholder_svg_tag: 'ms-product-card__placeholder-img' }}
            </div>
            <div class="ms-product-card__body">
              <div class="ms-product-card__brand">Marka</div>
              <h3 class="ms-product-card__title">Przykładowy produkt {{ i }}</h3>
              <div class="ms-product-card__price">
                <span class="ms-price">999 zł</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Polecane produkty",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Polecane produkty" },
    { "type": "text", "id": "subheading", "label": "Podtytuł" },
    { "type": "collection", "id": "collection", "label": "Kolekcja" },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Produkty w rzędzie (desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "rows",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Liczba rzędów",
      "default": 2
    },
    { "type": "text", "id": "view_all_label", "label": "Tekst \"Zobacz wszystkie\"", "default": "Zobacz wszystkie" },
    { "type": "url", "id": "view_all_link", "label": "Link \"Zobacz wszystkie\"" }
  ],
  "presets": [
    {
      "name": "Polecane produkty",
      "settings": {
        "heading": "Polecane produkty",
        "products_per_row": 4,
        "rows": 2
      }
    }
  ]
}
{% endschema %}
