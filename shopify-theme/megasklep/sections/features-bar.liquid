<section class="ms-features">
  <div class="ms-container">
    <div class="ms-features__grid">
      {% for block in section.blocks %}
        <div class="ms-feature-item" {{ block.shopify_attributes }}>
          <div class="ms-feature-item__icon ms-feature-item__icon--{{ block.settings.color }}">
            {% if block.settings.icon == 'truck' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            {% elsif block.settings.icon == 'rotate' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.5"/></svg>
            {% elsif block.settings.icon == 'credit-card' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            {% elsif block.settings.icon == 'shield' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {% elsif block.settings.icon == 'headphones' %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
            {% else %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {% endif %}
          </div>
          <div class="ms-feature-item__text">
            <strong>{{ block.settings.title }}</strong>
            <span>{{ block.settings.description }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pasek korzyści",
  "blocks": [
    {
      "type": "feature",
      "name": "Korzyść",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ikona",
          "options": [
            { "value": "truck", "label": "Ciężarówka (dostawa)" },
            { "value": "rotate", "label": "Strzałka (zwrot)" },
            { "value": "credit-card", "label": "Karta (płatność)" },
            { "value": "shield", "label": "Tarcza (gwarancja)" },
            { "value": "headphones", "label": "Słuchawki (wsparcie)" },
            { "value": "star", "label": "Gwiazdka (lojalność)" }
          ],
          "default": "truck"
        },
        {
          "type": "select",
          "id": "color",
          "label": "Kolor ikony",
          "options": [
            { "value": "blue", "label": "Niebieski" },
            { "value": "green", "label": "Zielony" },
            { "value": "amber", "label": "Złoty" }
          ],
          "default": "blue"
        },
        { "type": "text", "id": "title", "label": "Tytuł", "default": "Darmowa dostawa" },
        { "type": "text", "id": "description", "label": "Opis", "default": "Od 299 zł zamówienia" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pasek korzyści",
      "blocks": [
        { "type": "feature", "settings": { "icon": "truck", "color": "blue", "title": "Darmowa dostawa", "description": "Od 299 zł zamówienia" } },
        { "type": "feature", "settings": { "icon": "rotate", "color": "green", "title": "Zwrot 30 dni", "description": "Bez podawania przyczyny" } },
        { "type": "feature", "settings": { "icon": "credit-card", "color": "amber", "title": "Raty 0%", "description": "Nawet do 36 rat" } },
        { "type": "feature", "settings": { "icon": "shield", "color": "blue", "title": "Oryginalne produkty", "description": "Gwarancja autentyczności" } },
        { "type": "feature", "settings": { "icon": "headphones", "color": "amber", "title": "Wsparcie 24/7", "description": "Zawsze do Twojej dyspozycji" } },
        { "type": "feature", "settings": { "icon": "star", "color": "amber", "title": "Program lojalnościowy", "description": "Zbieraj punkty i oszczędzaj" } }
      ]
    }
  ]
}
{% endschema %}
