<section class="ms-hero" id="ms-hero" aria-label="Baner główny">
  <div class="ms-slideshow" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.autoplay_speed }}">

    {% for block in section.blocks %}
      {% if block.type == 'slide' %}
        <div class="ms-slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
          <div class="ms-slide__bg">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 1920 }}"
                srcset="{{ block.settings.image | image_url: width: 768 }} 768w, {{ block.settings.image | image_url: width: 1280 }} 1280w, {{ block.settings.image | image_url: width: 1920 }} 1920w"
                alt="{{ block.settings.heading | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="1920" height="800"
              >
            {% else %}
              <div class="ms-slide__placeholder" style="background: linear-gradient(135deg, {{ block.settings.color_from }}, {{ block.settings.color_to }});"></div>
            {% endif %}
            <div class="ms-slide__overlay" style="background: linear-gradient(to right, {{ block.settings.color_from }}CC, {{ block.settings.color_to }}99);"></div>
          </div>
          <div class="ms-slide__content ms-container">
            {% if block.settings.badge != blank %}
              <span class="ms-slide__badge">{{ block.settings.badge }}</span>
            {% endif %}
            <h2 class="ms-slide__heading">{{ block.settings.heading }}</h2>
            <p class="ms-slide__subheading">{{ block.settings.subheading }}</p>
            {% if block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link }}" class="ms-btn ms-btn--white ms-slide__btn">
                {{ block.settings.button_label }}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% if section.blocks.size > 1 %}
      <!-- Arrows -->
      <button class="ms-slideshow__arrow ms-slideshow__arrow--prev" aria-label="Poprzedni slajd">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="ms-slideshow__arrow ms-slideshow__arrow--next" aria-label="Następny slajd">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <!-- Dots -->
      <div class="ms-slideshow__dots" aria-hidden="true">
        {% for block in section.blocks %}
          {% if block.type == 'slide' %}
            <button class="ms-slideshow__dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Slajd {{ forloop.index }}"></button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Baner / Slideshow",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Automatyczne przewijanie", "default": true },
    { "type": "range", "id": "autoplay_speed", "min": 2, "max": 10, "step": 1, "unit": "s", "label": "Szybkość (sekundy)", "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slajd",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Zdjęcie" },
        { "type": "color", "id": "color_from", "label": "Kolor gradient (od)", "default": "#1e3a8a" },
        { "type": "color", "id": "color_to", "label": "Kolor gradient (do)", "default": "#1d4ed8" },
        { "type": "text", "id": "badge", "label": "Odznaka", "default": "Do -30%" },
        { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Letnia Wyprzedaż AGD" },
        { "type": "textarea", "id": "subheading", "label": "Podtytuł", "default": "Oszczędź do 30% na sprzętach AGD" },
        { "type": "text", "id": "button_label", "label": "Tekst przycisku", "default": "Sprawdź ofertę" },
        { "type": "url", "id": "button_link", "label": "Link przycisku" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Baner / Slideshow",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "badge": "Do -30%",
            "heading": "Letnia Wyprzedaż AGD",
            "subheading": "Oszczędź do 30% na sprzętach AGD",
            "button_label": "Sprawdź ofertę",
            "color_from": "#1e3a8a",
            "color_to": "#1d4ed8"
          }
        },
        {
          "type": "slide",
          "settings": {
            "badge": "Nowości",
            "heading": "Nowa Elektronika 2025",
            "subheading": "Najnowsze laptopy, smartfony i TV",
            "button_label": "Zobacz nowości",
            "color_from": "#0f172a",
            "color_to": "#1e293b"
          }
        },
        {
          "type": "slide",
          "settings": {
            "badge": "Dostawa 48h",
            "heading": "Urządź Dom z Klasą",
            "subheading": "Meble skandynawskie z dostawą w 48h",
            "button_label": "Wybierz meble",
            "color_from": "#064e3b",
            "color_to": "#059669"
          }
        }
      ]
    }
  ]
}
{% endschema %}
