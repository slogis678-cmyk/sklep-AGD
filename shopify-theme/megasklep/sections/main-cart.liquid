<div class="ms-cart-page ms-section">
  <div class="ms-container">
    <nav class="ms-breadcrumbs">
      <a href="{{ routes.root_url }}">Strona główna</a>
      <span>/</span>
      <span>Koszyk</span>
    </nav>
    <h1 class="ms-cart-page__title">Koszyk
      {% if cart.item_count > 0 %}
        <span class="ms-cart-page__count">({{ cart.item_count }})</span>
      {% endif %}
    </h1>

    {% if cart.item_count > 0 %}
      <div class="ms-cart-page__layout">
        <!-- Items -->
        <div class="ms-cart-items">
          {% for item in cart.items %}
            <div class="ms-cart-item" data-key="{{ item.key }}">
              <a href="{{ item.url }}" class="ms-cart-item__img">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="80" loading="lazy">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </a>
              <div class="ms-cart-item__info">
                <div class="ms-cart-item__vendor">{{ item.vendor }}</div>
                <a href="{{ item.url }}" class="ms-cart-item__title">{{ item.product.title }}</a>
                {% unless item.variant.title == 'Default Title' %}
                  <div class="ms-cart-item__variant">{{ item.variant.title }}</div>
                {% endunless %}
                <div class="ms-cart-item__controls">
                  <div class="ms-qty-input">
                    <button type="button" class="ms-qty-btn" data-cart-qty-minus data-key="{{ item.key }}" aria-label="Zmniejsz">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </button>
                    <span class="ms-qty-num">{{ item.quantity }}</span>
                    <button type="button" class="ms-qty-btn" data-cart-qty-plus data-key="{{ item.key }}" aria-label="Zwiększ">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </button>
                  </div>
                  <button class="ms-cart-item__remove" data-cart-remove data-key="{{ item.key }}" aria-label="Usuń">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                  </button>
                </div>
              </div>
              <div class="ms-cart-item__price">
                {{ item.final_line_price | money }}
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Summary -->
        <div class="ms-cart-summary">
          <h2 class="ms-cart-summary__title">Podsumowanie</h2>
          <div class="ms-cart-summary__rows">
            <div class="ms-cart-summary__row">
              <span>Wartość produktów:</span>
              <span>{{ cart.original_total_price | money }}</span>
            </div>
            {% if cart.cart_level_discount_applications.size > 0 %}
              {% for discount in cart.cart_level_discount_applications %}
                <div class="ms-cart-summary__row ms-cart-summary__row--discount">
                  <span>{{ discount.title }}</span>
                  <span>-{{ discount.total_allocated_amount | money }}</span>
                </div>
              {% endfor %}
            {% endif %}
            <div class="ms-cart-summary__row">
              <span>Dostawa:</span>
              <span class="{% if cart.total_price >= 29900 %}ms-free-delivery{% endif %}">
                {% if cart.total_price >= 29900 %}Darmowa{% else %}od 19 zł{% endif %}
              </span>
            </div>
          </div>

          {% if cart.total_price < 29900 %}
            <div class="ms-cart-delivery-progress">
              <p>Do darmowej dostawy brakuje: <strong>{{ 29900 | minus: cart.total_price | money }}</strong></p>
              <div class="ms-progress-bar">
                <div class="ms-progress-bar__fill" style="width: {{ cart.total_price | times: 100 | divided_by: 29900 }}%"></div>
              </div>
            </div>
          {% endif %}

          <div class="ms-cart-summary__total">
            <span>Łącznie:</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <a href="{{ routes.checkout }}" class="ms-btn ms-btn--primary ms-btn--large ms-btn--full">
            Przejdź do kasy
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="{{ routes.all_products_collection_url }}" class="ms-btn ms-btn--outline ms-btn--large ms-btn--full" style="margin-top:0.5rem;">
            Kontynuuj zakupy
          </a>

          <div class="ms-cart-payment-icons">
            <span class="ms-payment-badge">VISA</span>
            <span class="ms-payment-badge">MC</span>
            <span class="ms-payment-badge">BLIK</span>
            <span class="ms-payment-badge">P24</span>
            <span class="ms-payment-badge">PayPal</span>
          </div>
        </div>
      </div>
    {% else %}
      <div class="ms-empty-state">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <h2>Twój koszyk jest pusty</h2>
        <p>Dodaj produkty, aby kontynuować zakupy.</p>
        <a href="{{ routes.all_products_collection_url }}" class="ms-btn ms-btn--primary">Przejdź do sklepu</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Koszyk"
}
{% endschema %}
