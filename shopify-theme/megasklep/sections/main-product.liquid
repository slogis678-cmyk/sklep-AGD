<div class="ms-product-page ms-section">
  <div class="ms-container">

    <!-- Breadcrumbs -->
    <nav class="ms-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Strona główna</a>
      <span>/</span>
      {% if collection %}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span>/</span>
      {% endif %}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="ms-product-page__inner">
      <!-- Gallery -->
      <div class="ms-product-gallery">
        <div class="ms-product-gallery__main" id="ms-gallery-main">
          {% if product.featured_image %}
            <img
              id="ms-gallery-img"
              src="{{ product.featured_image | image_url: width: 800 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="800"
              height="800"
              loading="eager"
            >
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'ms-gallery-placeholder' }}
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
          <div class="ms-product-gallery__thumbs">
            {% for image in product.images %}
              <button
                class="ms-gallery-thumb {% if forloop.first %}is-active{% endif %}"
                data-src="{{ image | image_url: width: 800 }}"
                data-alt="{{ image.alt | escape }}"
                aria-label="Zdjęcie {{ forloop.index }}"
              >
                <img src="{{ image | image_url: width: 120 }}" alt="{{ image.alt | escape }}" width="120" height="120" loading="lazy">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Info -->
      <div class="ms-product-info">
        <div class="ms-product-info__brand">{{ product.vendor }}</div>
        <h1 class="ms-product-info__title">{{ product.title }}</h1>

        <!-- Rating -->
        <div class="ms-product-info__rating">
          <div class="ms-stars">
            {% assign rating = product.metafields.reviews.rating.value.rating | default: 4.5 %}
            {% for i in (1..5) %}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="{% if i <= rating %}#f59e0b{% else %}#e5e7eb{% endif %}" stroke="{% if i <= rating %}#f59e0b{% else %}#e5e7eb{% endif %}" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {% endfor %}
          </div>
          <span class="ms-product-info__reviews">
            {{ product.metafields.reviews.rating_count | default: '—' }} opinii
          </span>
        </div>

        <!-- Price -->
        <div class="ms-product-info__price-wrap">
          {% if product.compare_at_price > product.price %}
            <span class="ms-price ms-price--sale">{{ product.price | money }}</span>
            <span class="ms-price ms-price--compare">{{ product.compare_at_price | money }}</span>
            {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
            <span class="ms-badge ms-badge--red">-{{ discount }}%</span>
          {% else %}
            <span class="ms-price">{{ product.price | money }}</span>
          {% endif %}
        </div>

        {% form 'product', product, id: 'ms-product-form', class: 'ms-product-form' %}
          <!-- Variants -->
          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <div class="ms-product-option">
                <label class="ms-product-option__label">{{ option.name }}: <strong>{{ option.selected_value }}</strong></label>
                <div class="ms-product-option__values">
                  {% for value in option.values %}
                    <label class="ms-option-swatch {% if option.selected_value == value %}is-active{% endif %}">
                      <input
                        type="radio"
                        name="option{{ forloop.parentloop.index }}"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                        class="ms-option-radio"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                      >
                      <span>{{ value }}</span>
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endunless %}

          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="ms-variant-id">

          <!-- Quantity -->
          <div class="ms-product-qty">
            <label class="ms-product-option__label">Ilość:</label>
            <div class="ms-qty-input">
              <button type="button" class="ms-qty-btn" data-qty-minus aria-label="Zmniejsz">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <input type="number" name="quantity" value="1" min="1" class="ms-qty-num" id="ms-qty" aria-label="Ilość">
              <button type="button" class="ms-qty-btn" data-qty-plus aria-label="Zwiększ">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
            </div>
          </div>

          <!-- Actions -->
          <div class="ms-product-actions">
            <button
              type="submit"
              name="add"
              class="ms-btn ms-btn--primary ms-btn--large ms-add-to-cart"
              {% unless product.available %}disabled{% endunless %}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              {% if product.available %}
                Dodaj do koszyka
              {% else %}
                Niedostępny
              {% endif %}
            </button>
            <button type="button" class="ms-btn ms-btn--outline ms-wishlist-btn" data-product-id="{{ product.id }}" aria-label="Dodaj do ulubionych">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </button>
          </div>
        {% endform %}

        <!-- USPs -->
        <div class="ms-product-usps">
          <div class="ms-product-usp">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            Darmowa dostawa od 299 zł
          </div>
          <div class="ms-product-usp">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.5"/></svg>
            Zwrot w ciągu 30 dni
          </div>
          <div class="ms-product-usp">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            Raty 0% — nawet 36 rat
          </div>
        </div>

        <!-- Description -->
        {% if product.description != blank %}
          <div class="ms-product-desc">
            <h3>Opis produktu</h3>
            <div class="ms-product-desc__body rte">{{ product.description }}</div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Strona produktu"
}
{% endschema %}
