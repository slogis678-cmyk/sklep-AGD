<section class="ms-newsletter">
  <div class="ms-container">
    <div class="ms-newsletter__inner">
      <div class="ms-newsletter__text">
        <h2 class="ms-newsletter__heading">{{ section.settings.heading }}</h2>
        <p class="ms-newsletter__sub">{{ section.settings.subheading }}</p>
      </div>
      <form class="ms-newsletter__form" action="/contact#newsletter" method="post" id="ms-newsletter-form">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="ms-newsletter__input-wrap">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder }}"
            class="ms-newsletter__input"
            required
            aria-label="Adres e-mail"
          >
          <button type="submit" class="ms-btn ms-btn--primary">{{ section.settings.button }}</button>
        </div>
        <p class="ms-newsletter__legal">{{ section.settings.legal }}</p>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Zapisz się do newslettera" },
    { "type": "text", "id": "subheading", "label": "Podtytuł", "default": "Otrzymuj najnowsze oferty i promocje jako pierwszy." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Twój adres e-mail" },
    { "type": "text", "id": "button", "label": "Tekst przycisku", "default": "Zapisz się" },
    { "type": "richtext", "id": "legal", "label": "Tekst prawny", "default": "<p>Zapisując się, akceptujesz <a href=\"/pages/polityka-prywatnosci\">politykę prywatności</a>. Możesz zrezygnować w każdej chwili.</p>" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
