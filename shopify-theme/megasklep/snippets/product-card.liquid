{% comment %}
  Renders a product card.
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign on_sale = false %}
{% if current_variant.compare_at_price > current_variant.price %}
  {% assign on_sale = true %}
  {% assign discount = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price %}
{% endif %}

<div class="ms-product-card" data-product-id="{{ product.id }}">
  <div class="ms-product-card__img-wrap">
    <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {% if product.featured_image %}
        <img
          class="ms-product-card__img"
          src="{{ product.featured_image | image_url: width: 600 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          loading="lazy"
          width="600"
          height="600"
        >
        {% if product.images.size > 1 %}
          <img
            class="ms-product-card__img ms-product-card__img--hover"
            src="{{ product.images[1] | image_url: width: 600 }}"
            alt="{{ product.images[1].alt | default: product.title | escape }}"
            loading="lazy"
            width="600"
            height="600"
          >
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'ms-product-card__img ms-product-card__img--placeholder' }}
      {% endif %}
    </a>

    <!-- Badges -->
    <div class="ms-product-card__badges">
      {% if on_sale %}
        <span class="ms-badge ms-badge--red">-{{ discount }}%</span>
      {% endif %}
      {% if product.tags contains 'new' or product.tags contains 'nowość' %}
        <span class="ms-badge ms-badge--blue">Nowość</span>
      {% endif %}
      {% if product.tags contains 'bestseller' %}
        <span class="ms-badge ms-badge--green">Bestseller</span>
      {% endif %}
    </div>

    <!-- Actions -->
    {% unless current_variant.available %}
      <div class="ms-product-card__sold-out">
        <span>Niedostępny</span>
      </div>
    {% endunless %}

    <div class="ms-product-card__overlay-actions">
      <button
        class="ms-overlay-btn ms-wishlist-btn"
        data-product-id="{{ product.id }}"
        aria-label="Dodaj do ulubionych"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </button>
      <a href="{{ product.url }}" class="ms-overlay-btn" aria-label="Szczegóły produktu">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      </a>
    </div>
  </div>

  <div class="ms-product-card__body">
    <div class="ms-product-card__brand">{{ product.vendor }}</div>
    <a href="{{ product.url }}" class="ms-product-card__title">{{ product.title }}</a>

    <!-- Rating (metafields) -->
    {% if product.metafields.reviews.rating.value != blank %}
      <div class="ms-product-card__rating">
        {% assign r = product.metafields.reviews.rating.value.rating %}
        <div class="ms-stars ms-stars--sm">
          {% for i in (1..5) %}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="{% if i <= r %}#f59e0b{% else %}#e5e7eb{% endif %}" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          {% endfor %}
        </div>
        <span class="ms-product-card__review-count">{{ product.metafields.reviews.rating_count }}</span>
      </div>
    {% endif %}

    <!-- Price -->
    <div class="ms-product-card__price-row">
      <div class="ms-product-card__prices">
        <span class="ms-price{% if on_sale %} ms-price--sale{% endif %}">{{ current_variant.price | money }}</span>
        {% if on_sale %}
          <span class="ms-price ms-price--compare">{{ current_variant.compare_at_price | money }}</span>
        {% endif %}
      </div>
      {% if current_variant.available %}
        <button
          class="ms-add-to-cart-btn"
          data-variant-id="{{ current_variant.id }}"
          data-product-title="{{ product.title | escape }}"
          aria-label="Dodaj do koszyka"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        </button>
      {% endif %}
    </div>
  </div>
</div>
